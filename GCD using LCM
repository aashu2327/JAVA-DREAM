import java.util.*;
public class Main
{
  public static int san (int a ,int b)
{
  int big=Math.max(a,b);
  int small=Math.min(a,b);
  int s=big;
  while(true)
  {
    if(big%small==0)
    break;
    big=big+s;
  }
  return big;
}

 
public static void main(String[] args)
    {
     int[]a={2,6};
     int lcm=a[0];
     int c=a[0]*a[1];
     int gcd=0;
     for(int i=0;i<2;i++)
     {
      lcm=san(lcm,a[i]);
      gcd=c/lcm;
     } 

     System.out.println("The LCM is"+" "+lcm);
     System.out.println("The GCD is"+ " "+gcd);
     
    }
}
