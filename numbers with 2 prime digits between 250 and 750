public class Main
{
    public static void main(String[] args) 
 {

        int c = 0;
        for (int i = 250; i <= 750; i++) {
        int n = i;
        int Count = 0;
        while (n != 0) 
           {
                int d = n % 10;
               if (d == 2 || d == 3 || d == 5 || d == 7) 
                {
                    Count++;
                }

                n = n / 10;
            }

            if (Count == 2) {
                c++;
                System.out.println(i);
            }
        }

        System.out.println("Total = " + c);
    }
}
