public class Main {
    public static void main(String[] args) {

        int d;
        boolean f;

        for (int i = 100; i < 1000; i++) {

            int n = i;
            f = true;

            while (n != 0) {
                d = n % 10;

                if (d != 7 && d != 5 && d != 3 && d != 2) {
                    f = false;
                    break;
                }

                n = n / 10;
            }

            if (f)
                System.out.println(i);
        }
    }
}
