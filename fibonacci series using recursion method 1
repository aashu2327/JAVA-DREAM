import java.util.*;
public class Main 
{
    public static int fibo(int n)
     {
        if (n <= 1)
        return n;
        else
        return fibo(n - 1) + fibo(n - 2);
    }

    public static void main(String[] args)
    {
      int b=14;
      for (int i=0;i<b;i++)
      {
        System.out.print(fibo(i) + " ");
      }
    }
}

