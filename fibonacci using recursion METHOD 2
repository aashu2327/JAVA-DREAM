import java.util.*;
public class Main 
{
    public static int fibo(int n)
     {
        if(n==1 || n<=1)
        return 0;
        if(n==2)
        return 1;
        return fibo((n-1)-(n-2));
    }

    public static void main(String[] args)
    {
      int b=14;
      for (int i=0;i<b;i++)
      {
        System.out.print(fibo(i) + " ");
      }
    }
}
